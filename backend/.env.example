# Back-end settings for an swf app. Copy to .env for local development (never commit .env).

# "development" locally, "production" on the server.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Interactive API docs at /api/docs (keep false in production).
DOCS_ENABLED=true

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Key-encryption key for every user's vault: 32 random bytes, urlsafe base64.
# Generate with:  python -m swf.cli generate-master-key  (or your app's cli)
# Losing it means losing every stored key and 2FA secret. Back it up separately from the database.
MASTER_KEY=

# Host names the app answers to, comma-separated. In production: your domain only.
ALLOWED_HOSTS=localhost,127.0.0.1

# Cookies are sent only over HTTPS. Browsers treat http://localhost as secure, so keep this true.
COOKIE_SECURE=true

# Passkeys: the bare domain, and the exact origin the browser shows (scheme + host + port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
PENDING_LOGIN_MINUTES=10

# Lockout and passwords
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Rate limits per client address
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_HOUR=60
RATE_LIMIT_API_PER_MINUTE=300

# Largest request body accepted, in bytes
MAX_REQUEST_BYTES=1048576

# Daily job that deletes data of accounts deactivated longer than the retention period
RETENTION_JOB_ENABLED=true
RETENTION_JOB_INTERVAL_HOURS=24
