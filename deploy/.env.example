# Production settings for docker compose. Copy to deploy/.env on the server (never commit it).

# The domain the app runs on. Its DNS A (and AAAA) record must point at the server.
APP_DOMAIN=app.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Which app to build (paths relative to the repository root)
APP_DIR=examples/notes/backend
APP_PACKAGE=notes_app
FRONTEND_DIR=examples/notes/frontend

# Database password. Generate with:  openssl rand -hex 32
POSTGRES_PASSWORD=

# Key-encryption key for all user vaults. Generate with:  openssl rand -base64 32 | tr '+/' '-_'
# Store a copy in your password manager. Without it, backups cannot be decrypted by the app.
MASTER_KEY=

# Optional overrides (defaults shown)
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# LOCKOUT_THRESHOLD=5
# LOCKOUT_MINUTES=15
# PASSWORD_MIN_LENGTH=12

# Backups (deploy/backup.sh): restic repository on a Hetzner Storage Box, and its password.
RESTIC_REPOSITORY=sftp:u000000@u000000.your-storagebox.de:/backups/app
RESTIC_PASSWORD=
# Must match RetentionPolicy(backup_days=...) in your AppConfig.
BACKUP_KEEP_DAYS=30
